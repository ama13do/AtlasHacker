    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@hono/node-server": "^1.13.8",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.0",
    "serverless-offline": "^13.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
