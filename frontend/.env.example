# URL base de la API, sin /api (las rutas ya lo incluyen).
# En `npm run dev` las llamadas pasan por el proxy de Vite (/api → esta URL); en el build se llama directo.
# API de pruebas en AWS:
VITE_API_URL=https://rwxdsyv0c2.execute-api.us-west-2.amazonaws.com
# Backend local (../backend, `npm run dev`):
# VITE_API_URL=http://localhost:3000

# Site key pública de Cloudflare Turnstile (subir testimonios y comentar)
# Para pruebas en local: 1x00000000000000000000AA (requiere el secreto de prueba en el back)
# VITE_TURNSTILE_SITE_KEY=

# Supabase Realtime (pines en vivo). La anon key es pública; NUNCA la service_role.
# Sin estas dos variables el mapa funciona igual, solo sin tiempo real.
# VITE_SUPABASE_URL=https://xirskbfqycougrtfpyqm.supabase.co
# VITE_SUPABASE_ANON_KEY=
