# ==========================================
# ATLAS HACKER BACKEND - CONFIGURACIÓN LOCAL & AWS
# ==========================================

PORT=3000
NODE_ENV=development

# ------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------
# URL de tu proyecto en Supabase (ej: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública Anon (usada principalmente en frontend o lecturas públicas)
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Clave secreta Service Role (¡CRÍTICO! Solo para backend en AWS Lambda / Servidor seguro)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ------------------------------------------
# CLOUDFLARE R2 (S3-COMPATIBLE STORAGE)
# ------------------------------------------
# Cloudflare Account ID (32 caracteres hexadecimales)
R2_ACCOUNT_ID=tu_cloudflare_account_id_aqui

# R2 Access Key ID
R2_ACCESS_KEY_ID=tu_r2_access_key_id_aqui

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui

# Nombre exacto del bucket R2 creado en Cloudflare
R2_BUCKET_NAME=atlashacker-media

# Dominio público configurado en Cloudflare R2 (ej: https://pub-xxxxxx.r2.dev o dominio propio)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ------------------------------------------
# AWS CREDENTIALS (Para despliegue con Serverless)
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key_aqui
