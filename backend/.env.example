# ==========================================================================================
# ATLAS HACKER · BACKEND  —  copia este archivo a ".env" (NUNCA lo subas a git: ya está en .gitignore)
# Verifica que todo esté bien con:  npm run entorno:verificar
# ==========================================================================================

PORT=3000
NODE_ENV=development
# Orígenes del frontend permitidos por CORS (separados por coma). Nunca "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL pública de la API (solo para el Swagger). Opcional en local.
# PUBLIC_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# false = desaparece /docs (Swagger). Con true está protegido con usuario y contraseña del dashboard.
DOCS_ENABLED=true

# ------------------------------------------------------------------------------------------
# BASE DE DATOS (Supabase Postgres + PostGIS)
# Supabase → botón "Connect" (arriba) → pestaña "ORM"/"Connection string" → sección Pooler.
# La conexión DIRECTA (db.xxxx.supabase.co) es solo IPv6: no funciona en AWS Lambda ni en muchas redes.
# Si la contraseña tiene caracteres especiales (/ @ # ? : espacio) codifícalos en la URL (p. ej. "/" → %2F).
# ------------------------------------------------------------------------------------------
# API en runtime → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres
# Migraciones → "Session pooler" (puerto 5432) o la directa si tu red tiene IPv6
DIRECT_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# ------------------------------------------------------------------------------------------
# SECRETOS PROPIOS — se generan solos con:  npm run secretos:generar
# RESPALDA ENCRYPTION_KEY y HASH_PEPPER en un gestor de contraseñas:
#   - ENCRYPTION_KEY cifra nombre/correo/teléfono/IP. Si se pierde, esos datos NO se recuperan.
#   - HASH_PEPPER firma los folios y los índices de búsqueda. Si cambia, los folios existentes dejan de funcionar.
#   - Usa valores DISTINTOS en cada ambiente (dev / prod).
# ------------------------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=
HASH_PEPPER=
# Duración del access token (minutos) y del refresh token (días)
ACCESS_TTL_MIN=15
REFRESH_TTL_DIAS=14

# ------------------------------------------------------------------------------------------
# SUPABASE (solo para emitir eventos de tiempo real; la API NO usa la anon key)
# Project Settings → API
# ------------------------------------------------------------------------------------------
SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# La anon key va en el FRONTEND (escucha el canal "mapa"); aquí no se necesita.
# SUPABASE_ANON_KEY=
REALTIME_TOPIC=mapa

# ------------------------------------------------------------------------------------------
# CLOUDFLARE R2 (evidencias). El bucket debe ser PRIVADO (sin acceso público r2.dev).
# ------------------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=atlashacker-media

# ------------------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (captcha) — dash.cloudflare.com → Turnstile → Add widget
# Aquí va la SECRET KEY; la "site key" va en el frontend.
# Claves de prueba (siempre pasan): secret 1x0000000000000000000000000000000AA · site 1x00000000000000000000AA
# En desarrollo, si se deja vacío, el captcha se omite. En producción es obligatorio.
# ------------------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------------------
# ASISTENTE DE IA (pregunta al Tribunal). Apagado por defecto.
# Se enciende con ASISTENTE_IA_ACTIVO=true y al menos una clave. Usa Groq (console.groq.com → API Keys) y,
# si Groq falla o no responde a tiempo, OpenRouter (openrouter.ai → Keys). Los modelos tienen valor por defecto.
# ------------------------------------------------------------------------------------------
ASISTENTE_IA_ACTIVO=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# ------------------------------------------------------------------------------------------
# AWS — SOLO para desplegar desde tu PC (no se envían a Lambda). Mejor: `aws configure` / perfiles SSO.
# Usa un usuario con permisos mínimos, no AdministratorAccess.
# ------------------------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
