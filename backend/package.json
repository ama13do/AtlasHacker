{
  "name": "atlashacker-backend",
  "version": "1.0.0",
  "description": "Backend Serverless para AtlasHacker (AWS Lambda + PostGIS Supabase + Cloudflare R2)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "tsc",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "keywords": [
    "serverless",
    "aws-lambda",
    "postgis",
    "supabase",
    "cloudflare-r2",
    "hono"
  ],
